# ============================================================
#  TG Parser — шаблон конфигурации
#
#  Скопируйте и заполните реальными значениями:
#      cp .env.example .env
#      nano .env
#
#  Файл .env НЕ коммитится и хранится только на сервере.
# ============================================================

# Токен Telegram-бота (получается у @BotFather)
BOT_TOKEN=

# Ваш Telegram ID (владелец бота, получает права администратора веб-интерфейса)
ADMIN_CHAT_ID=

# --- База данных (PostgreSQL) -----------------------------------
# Внутри Docker хост БД — это имя сервиса `postgres`.
# DB_URL собирается автоматически из этих трёх значений (см. docker-compose.yml),
# поэтому задавать DB_URL вручную НЕ нужно.
#
# ВАЖНО: POSTGRES_PASSWORD применяется ТОЛЬКО при первом запуске (инициализация
# пустого тома). Чтобы сменить пароль позже, см. раздел «Деплой» в README.md.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tg_parser

# --- Веб-интерфейс ----------------------------------------------
# Секретный ключ для подписи сессионных cookies.
# Сгенерируйте командой:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=

# --- Прочее ------------------------------------------------------
LOG_LEVEL=INFO
RESYNC_TIMER=180

# Порт, на котором веб-интерфейс будет доступен на сервере
WEB_PORT=8000
